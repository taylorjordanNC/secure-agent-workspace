{
  "mcpServers": {
    "slack-reader": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/slack-reader.mjs"],
      "env": {"SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}", "NODE_EXTRA_CA_CERTS": "/run/openshell-supervisor-ca/material/ca.crt"}
    },
    "gmail-reader": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/gmail-reader.mjs"],
      "env": {"GMAIL_ACCESS_TOKEN": "${GMAIL_ACCESS_TOKEN}", "NODE_EXTRA_CA_CERTS": "/run/openshell-supervisor-ca/material/ca.crt"}
    }
  }
}
